{
  "name": "@coremedia-labs/studio-client.main.content-hub-adapter-rss",
  "version": "2.0.6-SNAPSHOT",
  "author": "CoreMedia GmbH",
  "license": "CoreMedia Open Source License",
  "private": true,
  "dependencies": {
    "@coremedia/studio-client.core-icons": "^2110.2.0",
    "@coremedia/studio-client.main.content-hub-editor-components": "^2110.2.0",
    "@coremedia/studio-client.main.editor-components": "^2110.2.0",
    "@jangaroo/runtime": "^1.5.0"
  },
  "devDependencies": {
    "@coremedia/plugin-manager": "1.0.0-SNAPSHOT-3",
    "@jangaroo/build": "^3.0.2",
    "@jangaroo/core": "^3.0.2",
    "@jangaroo/publish": "^3.0.2",
    "@jangaroo/run": "^3.0.2",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "clean": "rimraf ./dist && rimraf ./build",
    "build": "jangaroo build",
    "watch": "jangaroo watch",
    "start": "jangaroo run",
    "upload-plugin": "upload-plugin ./dist --repository docker.rubin-ci-01.coremedia.vm/plugins/content-hub-adapter-rss/studio-client.main.content-hub-adapter-rss",
    "lint": "eslint --fix \"src/**/*.ts\""
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./dist/src/*.js"
    }
  },
  "publishConfig": {
    "directory": "dist",
    "exports": {
      "./*": {
        "types": "./src/*.d.ts",
        "default": "./src/*.js"
      }
    }
  }
}
